# ==============================================================================
# BROWSER-SAFE / PUBLIC CLIENT CONFIGURATION (SAFE FOR ANGULAR / GH PAGES)
# ==============================================================================
# The Supabase Project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=https://hlehsgwsjphvuyngzjry.supabase.co

# The Supabase Publishable Key (legacy anon key or modern sb_publishable_... key; safe in browser)
SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key_here

# ==============================================================================
# FORBIDDEN SECRETS (NEVER ADD TO FRONTEND CODE, GIT, OR BROWSER BUNDLES)
# ==============================================================================
# - SUPABASE_SERVICE_ROLE_KEY (Bypasses all Row Level Security - backend/admin only)
# - SUPABASE_DB_PASSWORD      (Direct database connection password)
# - SUPABASE_ACCESS_TOKEN     (Personal CLI token sbp_...)
# - JWT_SECRET                (Cryptographic signing secret)

# ==============================================================================
# E2E SYNTHETIC TEST IDENTITIES (LOCAL ONLY - NEVER COMMIT CREDENTIALS)
# ==============================================================================
