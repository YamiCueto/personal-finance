# ==============================================================================
# SECURITY: Secrets, Tokens, and Credentials (CRITICAL - NEVER COMMIT)
# ==============================================================================
# Environment files (all variations except .env.example)
.env
.env.*
*.env
!.env.example

# Local development environment overrides
src/environments/environment.local.ts
src/environments/*.secret.ts

# Private keys, certificates, and auth credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
*.credentials

# Supabase CLI local state, branches, and temporary credentials
supabase/.temp/
supabase/.branches/
.supabase/

# Package manager credentials
.npmrc
.yarnrc

# Database credentials & dumps
*.sql.backup
*.dump
dump.sql
credentials.json
service_account.json
*service_role*

# ==============================================================================
# Compiled Output & Build Artifacts
# ==============================================================================
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ==============================================================================
# Dependencies
# ==============================================================================
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# IDEs and Editors
# ==============================================================================
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# ==============================================================================
# System Files
