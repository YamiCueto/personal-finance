# ==============================================================================
# SECURITY: Secrets, Tokens, and Credentials (CRITICAL - NEVER COMMIT)
# ==============================================================================
# Environment files (all variations except .env.example)
.env
.env.*
*.env
!.env.example

# Local development environment overrides
src/environments/environment.local.ts
src/environments/*.secret.ts

# Private keys, certificates, and auth credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
*.credentials

# Supabase CLI local state, branches, and temporary credentials
supabase/.temp/
supabase/.branches/
.supabase/

# Package manager credentials
.npmrc
.yarnrc

# Database credentials & dumps
*.sql.backup
*.dump
dump.sql
credentials.json
service_account.json
*service_role*

# ==============================================================================
# Build & Runtime Artifacts
# ==============================================================================
/node_modules/
/.angular/cache/
/dist/
/out/
*.log
npm-debug.log*
yarn-debug.log*

# ==============================================================================
# OS & Editor Files (avoiding credential or cache leaks)
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
